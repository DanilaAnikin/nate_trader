# Copy to .env.local for development. Never commit real credentials.
# NEXT_PUBLIC_* values are fixed when the dashboard image is built.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required runtime-only SSR/service URL. Under the production containment
# network, use the UNIQUE internal gateway hostname (never generic "kong").
# For an ordinary hosted development project, use its HTTPS project URL.
SUPABASE_SERVER_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional build-time override. Default is the existing browser cookie name
# derived from NEXT_PUBLIC_SUPABASE_URL, even with a different internal host.
NEXT_PUBLIC_SUPABASE_AUTH_COOKIE_NAME=

# Explicit production-account binding, always server-only.
PRODUCTION_OWNER_USER_ID=
PRODUCTION_ACCOUNT_ID=
PRODUCTION_ALPACA_ACCOUNT_NUMBER=
PRODUCTION_ACCOUNT_MODE=paper

# Actions:read is required for private runtime/diagnostic artifacts.
# Environments:read resolves the selected mode's approved SHA; alternatively
# declare PRODUCTION_RELEASE_SHA explicitly (this does not replace the token).
GITHUB_TOKEN=
GITHUB_REPO=owner/nate_trader
GITHUB_STATE_REF=main
PRODUCTION_RELEASE_SHA=
BUILD_SHA=

# Optional explicit JSON epoch baseline. It must bind the selected account,
# approved release and exact portfolio/benchmark starting observations.
# Otherwise the server reads the persisted baseline at GITHUB_STATE_REF.
V11_EPOCH_BASELINE=

# Optional application maintenance freeze. This does not replace network/DB
# containment or authorize deploying main over the frozen production bridge.
DASHBOARD_MAINTENANCE_MODE=
ALLOW_LEGACY_DASHBOARD=false

# Executor credentials and TRADING_MODE do not belong in this dashboard.
# Account credentials are retrieved server-side through the verified Vault path.
