# ============================================================================
# Nate Trader — environment variables
#
# Copy to `.env` (agent / Python scripts) and `dashboard/.env.local`
# (Next.js dashboard). Both files are git-ignored. Real secrets live ONLY in
# GitHub Actions Secrets and the Vercel project — never commit them.
# ============================================================================

# --- Supabase (shared) ------------------------------------------------------
# Project: nate_trader (ref gvhqqucytbbtzmrpwjzn)
SUPABASE_URL=https://gvhqqucytbbtzmrpwjzn.supabase.co
# Service-role key — full DB access, bypasses RLS. SERVER/AGENT ONLY.
# Never expose to the browser; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard (Next.js — dashboard/.env.local / hosting env) ---------------
NEXT_PUBLIC_SUPABASE_URL=https://gvhqqucytbbtzmrpwjzn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Commit the dashboard image was built from. Reported by /api/health and shown
# in the UI separately from the approved paper release SHA.
BUILD_SHA=

# --- Dashboard V11 observability (server-only) ------------------------------
# Read-only GitHub token (public repo metadata + `actions: read`). Required to
# read workflow runs, the approved release variable and the private
# paper-runtime-state / paper-diagnostics artifacts. Never exposed to the
# browser; without it the strategy sections report UNAVAILABLE.
GITHUB_TOKEN=
# Repository and default branch the dashboard reads research state from.
GITHUB_REPO=DanilaAnikin/nate_trader
GITHUB_STATE_REF=main

# Explicit production authorization. The frozen plan, pending order intents,
# preflight, executor results and workflow operations describe ONE central
# production account, so owning some Supabase account is not enough to read
# them. All of these must hold together (AND, never OR):
#   PRODUCTION_OWNER_USER_ID  — Supabase auth.users.id allowed to see the
#                               private production runtime. Required.
#   PRODUCTION_ACCOUNT_ID     — Supabase accounts.id the executor trades.
#                               Required. Must be paper and owned by the owner.
# Without both, no account is ever "production-controlled", V11 compliance is
# NOT_APPLICABLE, and the GitHub Actions API is not called for that viewer.
PRODUCTION_OWNER_USER_ID=
PRODUCTION_ACCOUNT_ID=

# Optional ADDITIONAL check (never an alternative proof). When set, the account
# number read fresh from Alpaca /v2/account must also match. A value stored in
# Supabase is never accepted. If it cannot be read, authorization fails closed.
PRODUCTION_ALPACA_ACCOUNT_NUMBER=

# Optional fallback for the approved paper release when the token cannot read
# the `paper-production` GitHub environment variable. Setting it here does NOT
# change what the executor trades; it only labels what the dashboard displays.
PRODUCTION_RELEASE_SHA=

# Optional inline V11 forward-validation epoch baseline (JSON). Normally this
# lives at state/v11_epoch_baseline.json in the approved release. Without a
# baseline, forward performance is reported as UNAVAILABLE rather than reusing
# pre-V11 account history.
V11_EPOCH_BASELINE=

# Explicit opt-in for the repository-only legacy shell (non-production only).
ALLOW_LEGACY_DASHBOARD=

# --- Alpaca (agent) ---------------------------------------------------------
# Legacy single-account vars. Once Phase 6 lands, per-account Alpaca keys live
# encrypted in Supabase Vault and these are no longer used by routines.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Required only for an intentional mutating run. The sole accepted value is
# `paper`; unset/live/real values fail closed. No-argument execution is dry-run.
TRADING_MODE=

# --- Research data sources (agent) ------------------------------------------
PERPLEXITY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- Notifications (agent) --------------------------------------------------
CLICKUP_API_KEY=
CLICKUP_LIST_ID=

# Strategy parameters are versioned in scripts/strategy_config.py.
