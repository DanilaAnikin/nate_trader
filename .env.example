# ============================================================================
# Nate Trader — environment variables
#
# Copy to `.env` (agent / Python scripts) and `dashboard/.env.local`
# (Next.js dashboard). Both files are git-ignored. Real secrets live ONLY in
# GitHub Actions Secrets and in the environment of the origin host that runs
# the dashboard container (built from `dashboard/Dockerfile`) — never commit
# them. There is no Vercel project; the dashboard is self-hosted.
# ============================================================================

# --- Supabase (shared) ------------------------------------------------------
# Project: nate_trader (ref gvhqqucytbbtzmrpwjzn)
SUPABASE_URL=https://gvhqqucytbbtzmrpwjzn.supabase.co
# Service-role key — full DB access, bypasses RLS. SERVER/AGENT ONLY.
# Never expose to the browser; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard (Next.js — dashboard/.env.local / container env) -------------
NEXT_PUBLIC_SUPABASE_URL=https://gvhqqucytbbtzmrpwjzn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Runtime-only SSR/service gateway. Required; under containment use the unique
# internal Kong hostname. For a hosted Supabase dev project use its HTTPS URL.
SUPABASE_SERVER_URL=
# Optional build-time cookie name. Default preserves the public-host-derived
# Supabase session cookie when the server uses a different internal hostname.
NEXT_PUBLIC_SUPABASE_AUTH_COOKIE_NAME=

# Commit the dashboard image was built from. Reported by /api/health and shown
# in the UI separately from the approved paper release SHA.
BUILD_SHA=

# --- Dashboard V11 observability (server-only) ------------------------------
# Read-only GitHub token. ALWAYS REQUIRED: `Actions: read` is the only way to
# list workflow runs and download the private paper-runtime-state /
# paper-diagnostics artifacts. Without it the strategy sections report
# UNAVAILABLE, and no other variable substitutes for it.
#
# `Environments: read` is additionally needed to read the approved release from
# the paper-production environment. That one scope — and only that one — can be
# replaced by setting PRODUCTION_RELEASE_SHA below. Never exposed to the browser.
GITHUB_TOKEN=
# Repository and default branch the dashboard reads research state from.
GITHUB_REPO=DanilaAnikin/nate_trader
GITHUB_STATE_REF=main

# Explicit production authorization. The frozen plan, pending order intents,
# preflight, executor results and workflow operations describe ONE central
# production account, so owning some Supabase account is not enough to read
# them. All of these must hold together (AND, never OR):
#   PRODUCTION_OWNER_USER_ID  — Supabase auth.users.id allowed to see the
#                               private production runtime. Required.
#   PRODUCTION_ACCOUNT_ID     — Supabase accounts.id the executor trades.
#                               Required. Must be paper and owned by the owner.
#   PRODUCTION_ALPACA_ACCOUNT_NUMBER — REQUIRED. Owner + account + mode say
#                               who is asking about which row; only a
#                               broker-side identifier shows that the row's
#                               Vault credentials point at the account the
#                               executor trades. Compared against a value read
#                               fresh from Alpaca /v2/account; a value stored in
#                               Supabase is never accepted, and an unreadable
#                               broker fails the check closed.
#   PRODUCTION_ACCOUNT_MODE   — `paper` (default) or `live`. Which broker mode
#                               the production account is expected to be. The
#                               account's own mode must EQUAL this, in both
#                               directions, so a row edited in the database can
#                               never promote itself into the production view,
#                               and a paper account is never displayed under a
#                               live executor. Anything that is not exactly
#                               `live` means paper.
# Without the first three, no account is ever "production-controlled", V11
# compliance is NOT_APPLICABLE, and the GitHub Actions API is not called for
# that viewer.
PRODUCTION_OWNER_USER_ID=
PRODUCTION_ACCOUNT_ID=
PRODUCTION_ALPACA_ACCOUNT_NUMBER=
PRODUCTION_ACCOUNT_MODE=

# Alternative to the token's `Environments: read` scope only. It does NOT
# replace GITHUB_TOKEN, which is still required for `Actions: read`. Setting it
# does not change what the executor trades; it only tells the dashboard which
# release to bind artifacts and validation evidence to.
PRODUCTION_RELEASE_SHA=

# Optional inline V11 forward-validation epoch baseline (JSON). Normally this
# lives at state/v11_epoch_baseline.json in the approved release. Without a
# baseline, forward performance is reported as UNAVAILABLE rather than reusing
# pre-V11 account history.
V11_EPOCH_BASELINE=

# Explicit opt-in for the repository-only legacy shell (non-production only).
ALLOW_LEGACY_DASHBOARD=

# --- Alpaca (agent) ---------------------------------------------------------
# Legacy single-account vars. Once Phase 6 lands, per-account Alpaca keys live
# encrypted in Supabase Vault and these are no longer used by routines.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Required for any intentional mutating run. Exactly two values are recognised:
# `paper` and `live`. Anything else — including an empty value or a typo such as
# `Live!` — is a dry run, never a fallback to the other mode.
TRADING_MODE=

# --- Alpaca (REAL MONEY) ----------------------------------------------------
# Everything below is required together for TRADING_MODE=live. Any one of them
# missing refuses the run and names what is missing; nothing here has a default
# and nothing falls back to the paper values. Leave the whole block empty unless
# you intend real orders to reach a funded brokerage account.
#
# Live keys are deliberately NOT the ALPACA_API_KEY pair. Separate names mean a
# misfiled paper key fails to authenticate instead of quietly trading the wrong
# book, and a live key can never be picked up by a run that only asked for paper.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
# A second, independent switch. Two variables have to be wrong at once for real
# money to move by accident. Accepted: yes/true/1/on/enabled.
LIVE_TRADING_ENABLED=
# The Alpaca account number this run is allowed to trade, declared out of band.
# Verified against a fresh GET /v2/account before the first order: credentials
# prove *an* account, this proves *the* account.
LIVE_TRADING_ACCOUNT_NUMBER=
# Absolute dollar ceilings, enforced at the single order choke point. Every
# strategy limit in this repo is a percentage of equity, so a bug in the equity
# read or the target weights scales the mistake with the account instead of
# capping it. These do not. Sells are never capped — a ceiling that could block
# an exit would be worse than the risk it prevents.
LIVE_MAX_ORDER_NOTIONAL_USD=
LIVE_MAX_CYCLE_NOTIONAL_USD=
# Filesystem off switch, checked at call time. While this file exists live
# entries are refused and no deploy is needed to stop them; risk-reducing exits
# still work. Defaults to state/production/LIVE_TRADING_DISABLED.
LIVE_TRADING_KILL_SWITCH_FILE=

# --- Research data sources (agent) ------------------------------------------
PERPLEXITY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- Notifications (agent) --------------------------------------------------
CLICKUP_API_KEY=
CLICKUP_LIST_ID=

# Strategy parameters are versioned in scripts/strategy_config.py.
